    "check:converters": "node scripts/gen-converters.mjs --check",
    "gen:variants": "node scripts/gen-variants.mjs",
    "check:variants": "node scripts/gen-variants.mjs --check",
    "build:icon-font": "node scripts/build-icon-font.mjs",
    "check:icon-font": "node scripts/build-icon-font.mjs --check",
    "verify:build": "node scripts/verify-build.mjs",
    "i18n:keys": "node scripts/i18n-keys.mjs",
    "i18n:props": "node scripts/i18n-hardcoded.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs && node scripts/i18n-hardcoded.mjs",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "i18n:list": "node scripts/i18n-list.mjs",
    "i18n:plurals": "node scripts/i18n-plurals.mjs",
    "i18n:charset": "node scripts/i18n-charset.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs && node scripts/copy-ort.mjs && node scripts/gen-converters.mjs --check && node scripts/gen-variants.mjs --check && node scripts/build-icon-font.mjs --check && node scripts/i18n-audit.mjs && node scripts/i18n-hardcoded.mjs && node scripts/i18n-keys.mjs --check && node scripts/i18n-plurals.mjs && node scripts/i18n-charset.mjs && node scripts/generate-licenses.mjs",
    "build": "next build",
    "start": "next start",
