    "jszip": "^3.10.1",
    "marked": "^18.0.13",
    "mp4-muxer": "^5.2.2",
    "next": "16.3.8",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tesseract.js": "^7.0.0"
