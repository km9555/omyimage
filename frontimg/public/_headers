# Cloudflare Pages reads this file from the deploy root; `output: "export"`
# copies public/ verbatim into out/, so it lands there automatically.
#
# /_next/static/ filenames are content-hashed, but on a static export nothing
# sets their Cache-Control: Cloudflare Pages served them with
# `max-age=14400, must-revalidate` (4 h), so repeat visitors re-validated every
# chunk (seen in the 2026-11-14 SEO audit). A changed file is a changed URL,
# so a year of immutability is safe.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts/ filenames carry a content hash too (see scripts/build-icon-font.mjs),
# so a changed subset is a changed URL and a year of immutability is safe.
# Fonts are not pages: Search Console listed font URLs as "Crawled - currently
# not indexed", so tell crawlers not to consider them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

/_next/static/media/*
  X-Robots-Tag: noindex

/THIRD-PARTY-NOTICES.txt
  X-Robots-Tag: noindex

# ONNX Runtime's WebAssembly runtime (scripts/copy-ort.mjs) sits under a
# version folder, and the MI-GAN model parts carry the first 8 hex digits of
# the model's SHA-256 in their names, so a changed file is a changed URL.
/ort/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=31536000, immutable

# The *.pages.dev aliases (production and per-deploy/branch previews) serve a
# full copy of the site. Keep them out of search indexes; the custom domain
# omyimage.com does not match these host rules and is unaffected.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
