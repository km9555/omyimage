# Public site URL (no trailing slash) — used for SEO canonical URLs & sitemap.
NEXT_PUBLIC_SITE_URL=https://omyimage.com

# API base for large-file / heavy image processing. Since the backend merge this is
# the oMyPDF backend on Contabo (image tools live under /api/image/*).
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# GA4 measurement ID. Optional — the production property is the built-in default,
# so only set this to point a build at a different property (or "" to disable).
NEXT_PUBLIC_GA_ID=G-NL2CFW99NC

# ── Google Drive import (optional) ───────────────────────────────────────────
# Both are PUBLIC client-side identifiers — they ship in the browser bundle, so
# they are not secrets. The cloud project number is derived from the client ID's
# numeric prefix, so there is no third value to set.
#
# Leave either blank and the "import from Google Drive" control simply does not
# render, which is the correct behaviour for a build without credentials.
#
# Set up in Google Cloud Console (project "omyimage"):
#   1. Enable the Google Picker API and the Google Drive API
#   2. OAuth consent screen: External, app name "oMyImage", scope drive.file
#      (non-sensitive, so no Google verification review is required)
#   3. OAuth 2.0 Client ID, type "Web application", with Authorized JavaScript
#      origins for http://localhost:3002 and your production origin.
#      No redirect URIs are needed — the token client uses a popup.
#   4. API key restricted to the Picker API and to those same HTTP referrers
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
