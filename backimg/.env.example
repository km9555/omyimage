# Port the API listens on
PORT=5000

# Comma-separated allowed frontend origins (Cloudflare Pages domain in prod)
FRONTEND_ORIGIN=http://localhost:3000

# Max upload size in MB (plan layer can enforce tighter per-tier caps)
MAX_UPLOAD_MB=1024

# Max pixels per image (decompression-bomb guard), e.g. 50 megapixels
MAX_IMAGE_PIXELS=50000000

# Where ephemeral processed files are stored (defaults to OS temp dir)
# TMP_DIR=/var/tmp/omyimage

# ImageMagick binary used for HEIC decoding (see ai/README.md).
# Defaults to `magick` (v7), falling back to `convert` (v6).
# Must be built with libheif or /api/heic returns 501.
# MAGICK_BIN=/usr/bin/magick
